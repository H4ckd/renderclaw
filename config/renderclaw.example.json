{
  "app": {
    "name": "RenderClaw",
    "slug": "renderclaw"
  },
  "server": {
    "port": 5000,
    "dataDir": "data",
    "allowedDomains": ["example.com", "www.example.com"],
    "adminTokenEnv": "ADMIN_TOKEN"
  },
  "cache": {
    "ttlSeconds": 3600,
    "staleTtlSeconds": 86400,
    "sourceProbeTimeoutMs": 5000,
    "rules": [
      {
        "id": "fast-changing-blog",
        "domain": "example.com",
        "pathPattern": "^/blog/",
        "ttlSeconds": 900,
        "staleTtlSeconds": 21600
      }
    ]
  },
  "rendering": {
    "concurrency": 3,
    "maxQueueSize": 100,
    "maxRenderCount": 80,
    "pageTimeoutMs": 45000,
    "extraWaitMs": 1200,
    "maxHtmlBytes": 5242880
  },
  "rateLimit": {
    "enabled": true,
    "windowMs": 60000,
    "maxRequestsPerIp": 120,
    "maxRequestsPerDomain": 240
  },
  "crawl": {
    "maxQueueBatch": 50,
    "maxRenderBatch": 5,
    "maxDepth": 2,
    "maxRedirectBatch": 25,
    "maxRedirectHops": 5
  },
  "ai": {
    "enabled": true,
    "provider": "openai",
    "model": "gpt-4.1-mini",
    "timeoutMs": 4500,
    "apiKeyEnv": "OPENAI_API_KEY"
  }
}
