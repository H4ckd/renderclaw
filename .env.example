# Server
PORT=5000
DATA_DIR=data

# Production safety: set this to a comma-separated list of domains.
# Example: ALLOWED_DOMAINS=example.com,www.example.com
ALLOWED_DOMAINS=

# Cache
CACHE_TTL_SECONDS=3600
STALE_TTL_SECONDS=86400

# Rendering
RENDER_CONCURRENCY=3
MAX_RENDER_COUNT=80
PAGE_TIMEOUT_MS=45000
EXTRA_WAIT_MS=1200
MAX_HTML_BYTES=5242880

# AI optimization
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=4500
OPENAI_API_KEY=
