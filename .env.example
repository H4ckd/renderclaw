# Server
PORT=5000
DATA_DIR=data

# Production safety: set this to a comma-separated list of domains.
# Example: ALLOWED_DOMAINS=example.com,www.example.com
ALLOWED_DOMAINS=
ADMIN_TOKEN=

# Cache
CACHE_TTL_SECONDS=3600
STALE_TTL_SECONDS=86400

# Rendering
RENDER_CONCURRENCY=3
MAX_QUEUE_SIZE=100
MAX_RENDER_COUNT=80
PAGE_TIMEOUT_MS=45000
EXTRA_WAIT_MS=1200
MAX_HTML_BYTES=5242880

# Abuse protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS_PER_IP=120
RATE_LIMIT_MAX_REQUESTS_PER_DOMAIN=240

# Crawl intelligence
CRAWL_MAX_QUEUE_BATCH=50
CRAWL_MAX_RENDER_BATCH=5
CRAWL_MAX_DEPTH=2
CRAWL_MAX_REDIRECT_BATCH=25
CRAWL_MAX_REDIRECT_HOPS=5

# AI optimization
AI_ENABLED=true
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=4500
OPENAI_API_KEY=
